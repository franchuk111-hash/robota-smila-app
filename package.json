{
  "name": "robota-smila-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --import tsx --test scripts/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "next build --webpack",
    "dev": "next dev",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/release-guard.mjs && opennextjs-cloudflare build && node scripts/release-guard.mjs --built && wrangler deploy --keep-vars",
    "upload": "node scripts/release-guard.mjs && opennextjs-cloudflare build && node scripts/release-guard.mjs --built && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "telegram-post": "tsx scripts/telegram-post.ts",
    "telegram-publish": "tsx scripts/telegram-channel-publish.ts",
    "telegram-preview": "tsx scripts/preview-telegram.ts",
    "vacancies:sync": "tsx scripts/vacancy-pipeline.ts",
    "vacancies:test": "tsx scripts/vacancy-pipeline.test.ts",
    "add-vacancy": "tsx scripts/add-vacancy.ts",
    "add-vacancies-batch": "tsx scripts/add-vacancies-batch.ts",
    "release:check": "node scripts/release-guard.mjs"
  },
  "dependencies": {
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.31",
    "react": "19.2.8",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "postcss": "^8.5.22"
  }
}
